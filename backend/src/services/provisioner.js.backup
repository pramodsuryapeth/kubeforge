/**
 * Runs the actual cluster install, following the exact command sequence
 * from the project's reference setup guide (RKE2+Canal/Calico/Cilium,
 * kubeadm+Calico/Cilium/Flannel/Weave, Kubespray+Calico/Cilium/Flannel).
 * RKE2 and kubeadm execute real commands over SSH on each VM, one at a
 * time; Kubespray shells out locally to `ansible-playbook` against a
 * generated inventory — see README.md for the KUBESPRAY_PATH prerequisite.
 *
 * No firewall command is ever run here — the reference guide explicitly
 * excludes firewall setup, and setup never touches host firewall rules.
 *
 * Every command is logged via onLog() as it runs, and a failure throws a
 * ProvisionError carrying enough context (vm, command, result) for the
 * setup orchestrator to diagnose and repair it, then retry.
 */
const { execFile } = require('child_process');
const { promisify } = require('util');
const fs = require('fs');
const path = require('path');
const sshClient = require('./sshClient');
const { getCredential } = require('./cryptoVault');

const execFileAsync = promisify(execFile);

class ProvisionError extends Error {
  constructor(vm, command, result) {
    super(`Command failed on ${vm.name}: ${command}`);
    this.name = 'ProvisionError';
    this.vm = vm;
    this.command = command;
    this.result = result;
  }
}

const COMMON_PREP = [
  { command: 'swapoff -a', rollback: 'swapon -a', description: 'Disable swap' },
  { command: "sed -i '/ swap / s/^/#/' /etc/fstab", rollback: null, description: 'Persist swap-disabled across reboots' },
  { command: 'modprobe overlay', rollback: null, description: 'Load overlay kernel module' },
  { command: 'modprobe br_netfilter', rollback: null, description: 'Load br_netfilter kernel module' },
  { command: 'sysctl -w net.ipv4.ip_forward=1', rollback: null, description: 'Enable IPv4 forwarding' },
  { command: 'sysctl -w net.bridge.bridge-nf-call-iptables=1', rollback: null, description: 'Enable bridged-traffic iptables visibility' },
];

/** Derives the conventional cluster-dns IP: the 10th address in the Service CIDR range (e.g. 10.96.0.0/12 -> 10.96.0.10). */
function deriveClusterDNS(serviceCidr) {
  const base = serviceCidr.split('/')[0];
  const octets = base.split('.').map(Number);
  let n = ((octets[0] << 24) | (octets[1] << 16) | (octets[2] << 8) | octets[3]) >>> 0;
  n = (n + 10) >>> 0;
  return [24, 16, 8, 0].map((shift) => (n >>> shift) & 255).join('.');
}

/** Maps the project's chosen CNI onto RKE2's built-in `cni:` values (canal | calico | cilium). RKE2 has no standalone Flannel/Weave option — Canal (Flannel+Calico) is the closest built-in equivalent, matching RKE2's own default. */
function mapCniForRke2(cni) {
  if (cni === 'Calico') return 'calico';
  if (cni === 'Cilium') return 'cilium';
  return 'canal'; // Flannel, Weave, or anything else not natively supported by RKE2
}

/** The actual SSH login user's home directory — commands run wrapped in `sudo bash -c`, so `~`/$HOME inside them always resolves to root's home, not the real login user's. Kubeconfig needs to land here too, or `kubectl` only works for root, not for the person who actually SSHes in. */
function homeDirFor(vm) {
  return vm.username === 'root' ? '/root' : `/home/${vm.username}`;
}

/** Writes kubeconfig to root's home (so KubeForge's own remediation/validation steps, which run as root, always find it) AND to the interactive SSH user's home with correct ownership (so a human who SSHes in and runs `kubectl` from ~ gets a working, accurate result immediately — not a permissions error). No-ops the second copy when the SSH user already is root. */
async function writeKubeconfigForUser(vm, sourcePath, runOn) {
  const home = homeDirFor(vm);
  if (home === '/root') return; // already covered by the root copy the caller just did
  await runOn(
    vm,
    `mkdir -p ${home}/.kube && cp ${sourcePath} ${home}/.kube/config && chown -R ${vm.username}:${vm.username} ${home}/.kube`,
    { description: `Make kubectl work for ${vm.username} from their own home directory` },
  );
}

function runOnFactory(onLog) {
  return async (vm, command, { sudo = true, description } = {}) => {
    const credential = await getCredential(vm.credentialRef);

    if (!credential) {
      throw new ProvisionError(vm, command, {
        stdout: '',
        stderr: `No credential for "${vm.credentialRef}"`,
        code: 1,
      });
    }

    const commandName = description || command;

    // Command STARTED
    onLog({
      time: new Date().toISOString(),
      host: vm.name,
      command: commandName,
      output: '[RUNNING] Command is currently executing...',
      status: 'running',
      stage: 'provisioning',
    });

    let result;

    try {
      result = await sshClient.withConnection(
        vm,
        credential,
        (conn) =>
          sshClient.exec(conn, command, {
            sudo,
            password:
              credential.authType === 'password'
                ? credential.secret
                : null,
          }),
      );
    } catch (err) {
      result = {
        stdout: '',
        stderr: err.message,
        code: 1,
      };
    }

    // Command COMPLETED / FAILED
    onLog({
      time: new Date().toISOString(),
      host: vm.name,
      command: commandName,
      output:
        result.code === 0
          ? result.stdout || '[OK]'
          : `[ERROR] ${result.stderr || result.stdout || 'command failed'}`,
      status: result.code === 0 ? 'completed' : 'failed',
      stage: 'provisioning',
    });

    if (result.code !== 0) {
      throw new ProvisionError(vm, command, result);
    }

    return result;
  };
}

// ---------------------------------------------------------------------
// RKE2 + Canal/Calico/Cilium
// ---------------------------------------------------------------------

async function provisionRKE2(project, vms, runOn) {
  const [primaryCP, ...restCP] = vms.filter((v) => v.role === 'Control Plane');
  const workers = vms.filter((v) => v.role === 'Worker');
  const rke2Cni = mapCniForRke2(project.cni);
  const clusterDns = deriveClusterDNS(project.serviceCidr);

  const serverConfig = `cni: ${rke2Cni}\ncluster-cidr: ${project.podCidr}\nservice-cidr: ${project.serviceCidr}\ncluster-dns: ${clusterDns}\n`;
  const writeServerConfig = `mkdir -p /etc/rancher/rke2 && printf "${serverConfig.replace(/\n/g, '\\n')}" > /etc/rancher/rke2/config.yaml`;

  await runOn(primaryCP, writeServerConfig, { description: `Configure RKE2 (cni: ${rke2Cni})` });
  await runOn(primaryCP, 'curl -sfL https://get.rke2.io | sh -', { description: 'Install RKE2 server' });
  await runOn(primaryCP, 'systemctl enable --now rke2-server', { description: 'Start RKE2 server' });
  await runOn(primaryCP, 'ln -sf /var/lib/rancher/rke2/bin/kubectl /usr/local/bin/kubectl', { description: 'Link kubectl' });
  await runOn(primaryCP, "mkdir -p /root/.kube && cp /etc/rancher/rke2/rke2.yaml /root/.kube/config", { description: 'Write kubeconfig' });
  await writeKubeconfigForUser(primaryCP, '/etc/rancher/rke2/rke2.yaml', runOn);
  const tokenResult = await runOn(primaryCP, 'cat /var/lib/rancher/rke2/server/node-token', { description: 'Retrieve cluster join token' });
  const token = tokenResult.stdout.trim();

  for (const vm of restCP) {
    const cfg = `server: https://${primaryCP.ip}:9345\ntoken: ${token}\n`;
    // eslint-disable-next-line no-await-in-loop
    await runOn(vm, `mkdir -p /etc/rancher/rke2 && printf "${cfg.replace(/\n/g, '\\n')}" > /etc/rancher/rke2/config.yaml`, { description: 'Configure as additional control plane' });
    // eslint-disable-next-line no-await-in-loop
    await runOn(vm, 'curl -sfL https://get.rke2.io | sh -', { description: 'Install RKE2 server' });
    // eslint-disable-next-line no-await-in-loop
    await runOn(vm, 'systemctl enable --now rke2-server', { description: 'Start RKE2 server' });
  }

  for (const vm of workers) {
    const cfg = `server: https://${primaryCP.ip}:9345\ntoken: ${token}\n`;
    // eslint-disable-next-line no-await-in-loop
    await runOn(vm, `mkdir -p /etc/rancher/rke2 && printf "${cfg.replace(/\n/g, '\\n')}" > /etc/rancher/rke2/config.yaml`, { description: 'Configure RKE2 agent' });
    // eslint-disable-next-line no-await-in-loop
    await runOn(vm, 'curl -sfL https://get.rke2.io | INSTALL_RKE2_TYPE="agent" sh -', { description: 'Install RKE2 agent' });
    // eslint-disable-next-line no-await-in-loop
    await runOn(vm, 'systemctl enable --now rke2-agent', { description: 'Start RKE2 agent' });
  }
}

// ---------------------------------------------------------------------
// kubeadm + Calico/Cilium/Flannel/Weave
// ---------------------------------------------------------------------

async function installKubeadmCNI(project, primaryCP, runOn) {
  const { cni, podCidr } = project;

  if (cni === 'Calico') {
    await runOn(primaryCP, 'kubectl create -f https://raw.githubusercontent.com/projectcalico/calico/v3.31.0/manifests/operator-crds.yaml', { description: 'Install Calico operator CRDs' });
    await runOn(primaryCP, 'kubectl create -f https://raw.githubusercontent.com/projectcalico/calico/v3.31.0/manifests/tigera-operator.yaml', { description: 'Install Calico Tigera operator' });
    await runOn(primaryCP, 'curl -O https://raw.githubusercontent.com/projectcalico/calico/v3.31.0/manifests/custom-resources.yaml', { description: 'Download Calico custom-resources.yaml' });
    await runOn(primaryCP, `sed -i "s#192.168.0.0/16#${podCidr}#" custom-resources.yaml`, { description: 'Set Calico pod CIDR' });
    await runOn(primaryCP, 'kubectl create -f custom-resources.yaml', { description: 'Apply Calico custom resources' });
  } else if (cni === 'Cilium') {
    await runOn(primaryCP, 'curl -L --fail --remote-name-all https://github.com/cilium/cilium-cli/releases/latest/download/cilium-linux-amd64.tar.gz', { description: 'Download Cilium CLI' });
    await runOn(primaryCP, 'tar xzvf cilium-linux-amd64.tar.gz -C /usr/local/bin', { description: 'Install Cilium CLI' });
    await runOn(primaryCP, `cilium install --set ipam.mode=cluster-pool --set ipam.operator.clusterPoolIPv4PodCIDRList="${podCidr}"`, { description: 'Install Cilium CNI' });
  } else if (cni === 'Flannel') {
    await runOn(primaryCP, 'curl -LO https://github.com/flannel-io/flannel/releases/latest/download/kube-flannel.yml', { description: 'Download Flannel manifest' });
    await runOn(primaryCP, `sed -i "s#\\"Network\\": \\"10.244.0.0/16\\"#\\"Network\\": \\"${podCidr}\\"#" kube-flannel.yml`, { description: 'Set Flannel pod CIDR' });
    await runOn(primaryCP, 'kubectl apply -f kube-flannel.yml', { description: 'Apply Flannel CNI' });
  } else {
    // Weave — legacy: Weaveworks shut down, this targets a community fork and is best-effort.
    await runOn(primaryCP, `kubectl apply -f "https://reweave.azurewebsites.net/k8s/v1.30/net.yaml?env.IPALLOC_RANGE=${podCidr}"`, { description: 'Apply Weave CNI (legacy community fork)' });
  }
}
async function provisionKubeadm(project, vms, runOn) {
  const [primaryCP, ...restCP] = vms.filter((v) => v.role === 'Control Plane');
  const workers = vms.filter((v) => v.role === 'Worker');

  // Configure Kubernetes APT repository and install
  // kubeadm, kubelet, kubectl and containerd on every node.
  for (const vm of [primaryCP, ...restCP, ...workers]) {
    await runOn(
      vm,
      `apt-get update -qq &&
       apt-get install -y -qq apt-transport-https ca-certificates curl gpg &&
       mkdir -p -m 755 /etc/apt/keyrings &&
       curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.36/deb/Release.key |
         gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg &&
       chmod 644 /etc/apt/keyrings/kubernetes-apt-keyring.gpg &&
       echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.36/deb/ /' |
         tee /etc/apt/sources.list.d/kubernetes.list &&
       apt-get update -qq`,
      { description: 'Configure Kubernetes APT repository' }
    );

    await runOn(
      vm,
      'apt-get update -qq && apt-get install -y -qq containerd kubelet kubeadm kubectl && apt-mark hold kubelet kubeadm kubectl',
      { description: 'Install container runtime + kubeadm/kubelet/kubectl' }
    );

    await runOn(
      vm,
      'systemctl enable --now containerd',
      { description: 'Enable container runtime' }
    );
  }

  // Initialize Kubernetes on primary control plane
  await runOn(
    primaryCP,
    `kubeadm init --pod-network-cidr=${project.podCidr} --service-cidr=${project.serviceCidr}`,
    { description: 'kubeadm init' },
  );

  await runOn(
    primaryCP,
    'mkdir -p /root/.kube && cp -f /etc/kubernetes/admin.conf /root/.kube/config',
    { description: 'Write kubeconfig' }
  );

  await writeKubeconfigForUser(
    primaryCP,
    '/etc/kubernetes/admin.conf',
    runOn
  );

  await installKubeadmCNI(project, primaryCP, runOn);

  const joinResult = await runOn(
    primaryCP,
    'kubeadm token create --print-join-command',
    { description: 'Generate worker join command' }
  );

  const joinCommand = joinResult.stdout.trim();

  if (!joinCommand.startsWith('kubeadm join')) {
    throw new ProvisionError(
      primaryCP,
      'kubeadm token create --print-join-command',
      {
        stdout: joinResult.stdout,
        stderr: 'Unexpected output — expected a line starting with "kubeadm join"',
        code: 1
      }
    );
  }

  for (const vm of [...restCP, ...workers]) {
    await runOn(
      vm,
      joinCommand,
      { description: 'kubeadm join' }
    );
  }
}

// ---------------------------------------------------------------------
// Kubespray + Calico/Cilium/Flannel
// ---------------------------------------------------------------------

function mapCniForKubespray(cni) {
  if (cni === 'Calico') return 'calico';
  if (cni === 'Cilium') return 'cilium';
  if (cni === 'Flannel') return 'flannel';
  return 'calico'; // Kubespray dropped native Weave support — fall back to its default
}

/** Generates a minimal Ansible inventory + the CNI/CIDR group_vars for Kubespray from the given VM list. */
function writeKubesprayInventory(project, vms, kubesprayPath) {
  const cp = vms.filter((v) => v.role === 'Control Plane');
  const workers = vms.filter((v) => v.role === 'Worker');
  const hostLine = (vm) => `${vm.name} ansible_host=${vm.ip} ip=${vm.ip}`;

  const inventory = [
    '[kube_control_plane]',
    ...cp.map(hostLine),
    '',
    '[etcd]',
    ...cp.map((vm) => vm.name),
    '',
    '[kube_node]',
    ...workers.map(hostLine),
    '',
    '[k8s_cluster:children]',
    'kube_control_plane',
    'kube_node',
    '',
  ].join('\n');

  const inventoryDir = path.join(kubesprayPath, 'inventory', 'kubeforge');
  fs.mkdirSync(inventoryDir, { recursive: true });
  const inventoryPath = path.join(inventoryDir, 'hosts.ini');
  fs.writeFileSync(inventoryPath, inventory);

  const groupVarsDir = path.join(inventoryDir, 'group_vars', 'k8s_cluster');
  fs.mkdirSync(groupVarsDir, { recursive: true });
  const groupVars = [
    `kube_network_plugin: ${mapCniForKubespray(project.cni)}`,
    `kube_pods_subnet: ${project.podCidr}`,
    `kube_service_addresses: ${project.serviceCidr}`,
    '',
  ].join('\n');
  fs.writeFileSync(path.join(groupVarsDir, 'k8s-cluster.yml'), groupVars);

  return inventoryPath;
}

async function provisionKubespray(project, vms, onLog) {
  const kubesprayPath = process.env.KUBESPRAY_PATH;
  if (!kubesprayPath) {
    throw new Error('KUBESPRAY_PATH is not set. Kubespray runs as a local Ansible playbook against your VMs — clone Kubespray, pip install its requirements, and set KUBESPRAY_PATH in backend/.env. See README.md.');
  }

  const inventoryPath = writeKubesprayInventory(project, vms, kubesprayPath);
  onLog({ time: new Date().toISOString(), host: 'localhost', command: `Generated inventory + group_vars (cni: ${mapCniForKubespray(project.cni)}) at ${inventoryPath}`, output: '[OK]', stage: 'provisioning' });

  try {
    const { stdout } = await execFileAsync(
      'ansible-playbook',
      ['-i', inventoryPath, '-b', '-v', 'cluster.yml'],
      { cwd: kubesprayPath, maxBuffer: 1024 * 1024 * 20 },
    );
    onLog({ time: new Date().toISOString(), host: 'cluster', command: 'ansible-playbook -i <inventory> -b -v cluster.yml', output: stdout.slice(-4000), stage: 'provisioning' });
  } catch (err) {
    onLog({ time: new Date().toISOString(), host: 'cluster', command: 'ansible-playbook -i <inventory> -b -v cluster.yml', output: `[ERROR] ${err.message}`, stage: 'provisioning' });
    throw new ProvisionError({ name: 'kubespray-runner' }, 'ansible-playbook cluster.yml', { stdout: err.stdout || '', stderr: err.stderr || err.message, code: 1 });
  }
}

// ---------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------

/** Entry point: runs common prep on every given VM, then the method-specific install. `vms` defaults to every VM on the project if not given. */
async function provisionCluster(project, { onLog = () => {}, vms = project.vms } = {}) {
  const runOn = runOnFactory(onLog);

  // First line of every provisioning run: make the method being used
  // impossible to miss, so it's always obvious from the activity log
  // alone which path actually ran.
  onLog({
    time: new Date().toISOString(),
    host: 'cluster',
    command: '[PROVISION]',
    output: `Using provisioning method: ${project.provisioningMethod} (as configured on this project) with CNI: ${project.cni}`,
    stage: 'provisioning',
  });

  if (project.provisioningMethod !== 'Kubespray') {
    for (const vm of vms) {
      for (const step of COMMON_PREP) {
        // eslint-disable-next-line no-await-in-loop
        await runOn(vm, step.command, { description: step.description });
      }
    }
  }

  if (project.provisioningMethod === 'RKE2') {
    await provisionRKE2(project, vms, runOn);
  } else if (project.provisioningMethod === 'kubeadm') {
    await provisionKubeadm(project, vms, runOn);
  } else if (project.provisioningMethod === 'Kubespray') {
    await provisionKubespray(project, vms, onLog);
  } else {
    throw new Error(`Unknown provisioning method "${project.provisioningMethod}" — expected RKE2, kubeadm, or Kubespray`);
  }

  onLog({ time: new Date().toISOString(), host: 'cluster', command: '[PROVISION]', output: 'Kubernetes cluster provisioning completed successfully', stage: 'provisioning' });
}

/** Real teardown, used by Rollback after a cluster has actually been provisioned. */
async function uninstallCluster(project, { onLog = () => {}, vms = project.vms } = {}) {
  const runOn = runOnFactory(onLog);
  const cp = vms.filter((v) => v.role === 'Control Plane');
  const workers = vms.filter((v) => v.role === 'Worker');

  if (project.provisioningMethod === 'RKE2') {
    for (const vm of [...workers, ...cp]) {
      const script = vm.role === 'Worker' ? '/usr/local/bin/rke2-agent-uninstall.sh' : '/usr/local/bin/rke2-uninstall.sh';
      // eslint-disable-next-line no-await-in-loop
      await runOn(vm, `test -f ${script} && ${script} || echo "already removed"`, { description: 'Run RKE2 uninstall script' });
    }
  } else if (project.provisioningMethod === 'kubeadm') {
    for (const vm of [...workers, ...cp]) {
      // eslint-disable-next-line no-await-in-loop
      await runOn(vm, 'kubeadm reset -f && rm -rf /etc/cni/net.d ~/.kube', { description: 'kubeadm reset' });
    }
  } else {
    const kubesprayPath = process.env.KUBESPRAY_PATH;
    if (!kubesprayPath) throw new Error('KUBESPRAY_PATH is not set — cannot run the reset playbook');
    const inventoryPath = writeKubesprayInventory(project, vms, kubesprayPath);
    await execFileAsync('ansible-playbook', ['-i', inventoryPath, '-b', 'reset.yml', '-e', 'reset_confirmation=yes'], { cwd: kubesprayPath, maxBuffer: 1024 * 1024 * 20 });
    onLog({ time: new Date().toISOString(), host: 'cluster', command: 'ansible-playbook reset.yml', output: '[OK]', stage: 'provisioning' });
  }
}

/** Best-effort cleanup before retrying provisioning after a repair — only kubeadm needs this. */
async function cleanupBeforeRetry(project, onLog, vms = project.vms) {
  if (project.provisioningMethod !== 'kubeadm') return;
  const runOn = runOnFactory(() => {}); // swallow the reset's own log lines — only the outcome matters
  const controlPlanes = vms.filter((v) => v.role === 'Control Plane');
  for (const vm of controlPlanes) {
    try {
      // eslint-disable-next-line no-await-in-loop
      await runOn(vm, 'kubeadm reset -f || true', { description: 'Reset partial kubeadm state before retry' });
    } catch (err) {
      onLog({ time: new Date().toISOString(), host: vm.name, command: 'kubeadm reset -f', output: `[WARN] cleanup itself failed: ${err.message}`, stage: 'provisioning' });
    }
  }
}

module.exports = {
  provisionCluster, uninstallCluster, cleanupBeforeRetry, ProvisionError, COMMON_PREP, deriveClusterDNS, mapCniForRke2, mapCniForKubespray,
};
