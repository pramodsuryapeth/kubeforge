# Copy this file to .env and fill in real values.

# Port the Express API listens on
PORT=5000

# Base URL of the KubeForge AI service (Python/FastAPI)
AI_SERVICE_URL=http://localhost:8000

# MongoDB connection string. A local mongod works fine for development:
#   mongodb://127.0.0.1:27017/kubeforge
# or use a MongoDB Atlas connection string in production.
MONGODB_URI=mongodb://127.0.0.1:27017/kubeforge

# 32-byte (64 hex character) key used to encrypt VM credentials at rest
# (AES-256-GCM). Generate one with:
#   npm run generate-key
# Losing this key makes every stored credential permanently undecryptable —
# treat it like any other production secret (do not commit it).
CREDENTIAL_ENCRYPTION_KEY=

# Absolute path to a local Kubespray checkout, only needed if you'll use
# Kubespray as a provisioning method (it's an Ansible project that runs
# from this backend host against your VMs, not something installed on the
# VMs themselves). See README.md for setup.
KUBESPRAY_PATH=
